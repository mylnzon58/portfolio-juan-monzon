---
import SectionHeader from './SectionHeader.astro';

interface Highlight {
  value: string;
  label: string;
}

interface Props {
  title: string;
  paragraphs: string[];
  highlights: Highlight[];
  availabilityLabel: string;
  availabilityValue: string;
}

const { title, paragraphs, highlights, availabilityLabel, availabilityValue } = Astro.props;
---

<section id="sobre-mi" class="py-16 lg:py-24">
  <div class="container-atelier">
    <SectionHeader title={title} />

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-start lg:gap-12">
      <div class="reveal-on-scroll min-w-0 space-y-6 lg:col-span-7">
        {paragraphs.map((paragraph, idx) => (
          <p class={idx === 0 ? 'type-lead text-fg' : 'text-base leading-relaxed text-fg-secondary'}>
            {paragraph}
          </p>
        ))}

        <div class="pt-4">
          <div class="hairline-rule mb-6" aria-hidden="true" />
          <p class="text-xs font-semibold tracking-wide text-accent uppercase">
            {availabilityLabel}
          </p>
          <p class="mt-2 text-sm leading-relaxed text-fg">{availabilityValue}</p>
        </div>
      </div>

      <aside class="reveal-on-scroll min-w-0 lg:col-span-5" aria-label={title}>
        <div class="atelier-card atelier-card--padded">
          <dl class="space-y-6">
            {highlights.map((item, idx) => (
              <div>
                {idx > 0 && <div class="hairline-rule mb-6" aria-hidden="true" />}
                <div class="grid grid-cols-12 items-baseline gap-4">
                  <dt class="col-span-5 whitespace-nowrap font-display text-3xl font-normal leading-none tracking-tight text-fg sm:text-[2.125rem]">
                    {item.value}
                  </dt>
                  <dd class="col-span-7 text-sm leading-snug text-fg-secondary">
                    {item.label}
                  </dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
