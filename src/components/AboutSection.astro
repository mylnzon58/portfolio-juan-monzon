---
import SectionHeader from './SectionHeader.astro';

interface Highlight {
  value: string;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  paragraphs: string[];
  highlights: Highlight[];
  locationLabel: string;
  locationValue: string;
}

const {
  eyebrow,
  title,
  paragraphs,
  highlights,
  locationLabel,
  locationValue,
} = Astro.props;
---

<section id="sobre-mi" class="py-20 lg:py-28">
  <div class="container-editorial">
    <SectionHeader eyebrow={eyebrow} title={title} />

    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="min-w-0 space-y-6 lg:col-span-7 reveal-on-scroll">
        {paragraphs.map((paragraph, idx) => (
          <p class={idx === 0 ? 'type-lead text-fg' : 'text-base leading-relaxed text-muted'}>
            {paragraph}
          </p>
        ))}

        <div class="border-t border-border pt-6">
          <p class="type-meta mb-2 text-accent">{locationLabel}</p>
          <p class="text-sm leading-relaxed text-fg">{locationValue}</p>
        </div>
      </div>

      <aside class="min-w-0 lg:col-span-5 reveal-on-scroll" aria-label={eyebrow}>
        <dl class="divide-y divide-border border-y border-border">
          {highlights.map((item) => (
            <div class="grid grid-cols-12 items-baseline gap-4 py-6">
              <dt class="col-span-5 font-display text-4xl leading-none tracking-tight text-fg sm:text-5xl">
                {item.value}
              </dt>
              <dd class="col-span-7 text-sm leading-snug text-muted">
                {item.label}
              </dd>
            </div>
          ))}
        </dl>
      </aside>
    </div>
  </div>
</section>

