---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ArrowDownRight, ArrowUpRight } from '@lucide/astro';

interface LedgerEntry {
  value: string;
  label: string;
}

interface Cta {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  locationLine: string;
  fullName: string;
  roleLine: string;
  thesis: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  coverImage: ImageMetadata;
  coverAlt: string;
  coverCaption: string;
  avatarImage: ImageMetadata;
  avatarAlt: string;
  ledger: LedgerEntry[];
}

const {
  locationLine,
  fullName,
  roleLine,
  thesis,
  primaryCta,
  secondaryCta,
  coverImage,
  coverAlt,
  coverCaption,
  avatarImage,
  avatarAlt,
  ledger,
} = Astro.props;
---

<section id="inicio" class="pt-8 pb-16 sm:pt-12 lg:pt-14 lg:pb-24">
  <div class="container-atelier">
    <!-- Composición editorial asimétrica en 12 columnas con planos de profundidad en GSAP -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="min-w-0 space-y-6 lg:col-span-8">
        <div data-hero-reveal class="flex items-center gap-4">
          <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full bg-surface shadow-sm ring-2 ring-surface">
            <Picture
              src={avatarImage}
              alt={avatarAlt}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              widths={[112, 224]}
              sizes="56px"
              loading="eager"
              decoding="sync"
              fetchpriority="high"
              pictureAttributes={{ class: 'block h-full w-full' }}
              class="h-full w-full object-cover"
            />
          </div>
          <p class="text-sm font-medium text-muted">{locationLine}</p>
        </div>

        <div class="space-y-3.5">
          <h1 data-hero-reveal class="type-display text-fg">{fullName}</h1>
          <p data-hero-reveal class="text-base font-semibold tracking-[-0.01em] text-accent sm:text-lg">
            {roleLine}
          </p>
          <p data-hero-reveal class="type-lead max-w-[48ch] text-fg-secondary">
            {thesis}
          </p>
        </div>

        <div data-hero-reveal class="flex flex-wrap items-center gap-3.5 pt-1">
          <a href={primaryCta.href} class="btn-primary">
            <span>{primaryCta.label}</span>
            <ArrowDownRight size={17} stroke-width={2} aria-hidden="true" />
          </a>
          <a
            href={secondaryCta.href}
            target={secondaryCta.external ? '_blank' : undefined}
            rel={secondaryCta.external ? 'noopener noreferrer' : undefined}
            class="btn-secondary"
          >
            <span>{secondaryCta.label}</span>
            <ArrowUpRight size={17} stroke-width={1.75} aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Columna derecha asimétrica: métricas verificadas en una sola línea sin cortes -->
      <aside
        data-hero-reveal
        data-hero-ledger
        class="min-w-0 will-change-transform lg:col-span-4"
        aria-label={fullName}
      >
        <div class="atelier-card atelier-card--padded">
          <dl class="space-y-5">
            {ledger.map((entry, idx) => (
              <div>
                {idx > 0 && <div class="hairline-rule mb-5" aria-hidden="true" />}
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="shrink-0 whitespace-nowrap font-display text-3xl font-normal tracking-tight text-fg sm:text-[2rem]">
                    {entry.value}
                  </dt>
                  <dd class="text-right text-xs leading-snug text-muted sm:text-sm">
                    {entry.label}
                  </dd>
                </div>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    </div>

    <!-- Escenario panorámico 4:1 respetando el encuadre real con parallax multicapa en GSAP -->
    <figure
      data-hero-stage
      class="hero-stage relative mt-9 overflow-hidden will-change-transform lg:mt-11"
    >
      <div class="relative aspect-[16/8] overflow-hidden sm:aspect-[4/1]">
        <div data-hero-media class="absolute inset-0 will-change-transform">
          <Picture
            src={coverImage}
            alt={coverAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 1024, 1440]}
            sizes="(max-width: 1280px) 100vw, 1200px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            pictureAttributes={{ class: 'block h-full w-full' }}
            class="h-full w-full object-cover object-[72%_0%] sm:object-top"
          />
        </div>

        <figcaption
          data-hero-caption
          class="pointer-events-none absolute inset-x-0 bottom-0 hidden p-5 will-change-transform sm:flex"
        >
          <span class="glass-caption inline-flex items-center rounded-full px-5 py-2 text-xs font-medium text-fg">
            {coverCaption}
          </span>
        </figcaption>
      </div>
    </figure>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let heroCtx: gsap.Context | null = null;

  // GSAP + ScrollTrigger operan exclusivamente en el hero protegiendo LCP y encuadre inicial
  function initHeroParallax() {
    heroCtx?.revert();
    heroCtx = null;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const hero = document.getElementById('inicio');
    if (!hero) return;

    heroCtx = gsap.context(() => {
      gsap.from('[data-hero-reveal]', {
        y: 14,
        duration: 0.7,
        stagger: 0.06,
        ease: 'power3.out',
        clearProps: 'transform',
      });

      const stage = hero.querySelector('[data-hero-stage]');
      const media = hero.querySelector('[data-hero-media]');
      const caption = hero.querySelector('[data-hero-caption]');
      const ledger = hero.querySelector('[data-hero-ledger]');

      if (stage) {
        gsap.fromTo(
          stage,
          { scale: 0.98 },
          {
            scale: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: hero,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.55,
            },
          },
        );
      }

      if (media) {
        gsap.fromTo(
          media,
          { scale: 1.1, yPercent: 0, transformOrigin: 'center top' },
          {
            scale: 1.1,
            yPercent: 7,
            ease: 'none',
            scrollTrigger: {
              trigger: hero,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.6,
            },
          },
        );
      }

      if (caption) {
        gsap.fromTo(
          caption,
          { y: 0 },
          {
            y: -16,
            ease: 'none',
            scrollTrigger: {
              trigger: hero,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.6,
            },
          },
        );
      }

      if (ledger) {
        gsap.fromTo(
          ledger,
          { y: 0 },
          {
            y: -24,
            ease: 'none',
            scrollTrigger: {
              trigger: hero,
              start: 'top top',
              end: 'bottom top',
              scrub: 0.65,
            },
          },
        );
      }
    }, hero);
  }

  document.addEventListener('astro:page-load', initHeroParallax);
  document.addEventListener('astro:before-swap', () => {
    heroCtx?.revert();
    heroCtx = null;
  });
</script>
