---
import type { CollectionEntry } from 'astro:content';
import { ArrowUpRight, CircleCheck, CodeXml, Globe, Store } from '@lucide/astro';
import ProjectMedia from './ProjectMedia.astro';

interface Labels {
  demoLabel: string;
  repoLabel: string;
  storeLabel: string;
}

interface Props {
  project: CollectionEntry<'projects'>;
  labels: Labels;
}

const { project, labels } = Astro.props;
const { data } = project;

const isFeatured = data.layoutVariant === 'featured' || data.layoutVariant === 'featured-reverse';
const isReversed = data.layoutVariant === 'featured-reverse';

const colSpanClass = isFeatured
  ? 'lg:col-span-12'
  : data.layoutVariant === 'wide'
    ? 'lg:col-span-7'
    : 'lg:col-span-5';

const mediaSizes = isFeatured
  ? '(max-width: 1023px) 100vw, 58vw'
  : data.layoutVariant === 'wide'
    ? '(max-width: 1023px) 100vw, 56vw'
    : '(max-width: 1023px) 100vw, 42vw';

const mediaAspect = data.mediaAspect === '16/9' ? 'aspect-[16/9]' : 'aspect-[16/10]';
---

<article class={`atelier-card reveal-on-scroll min-w-0 ${colSpanClass}`}>
  <div class={isFeatured ? 'grid h-full grid-cols-1 lg:grid-cols-12 lg:items-center' : 'flex h-full flex-col'}>
    <div
      class={
        isFeatured
          ? `min-w-0 lg:col-span-7 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`
          : 'min-w-0'
      }
    >
      <ProjectMedia
        image={data.image}
        alt={data.imageAlt}
        sizes={mediaSizes}
        aspectClass={mediaAspect}
        tone={data.mediaTone}
        position={data.mediaPosition}
        fit={data.mediaFit}
      />
    </div>

    <div
      class={
        isFeatured
          ? `flex min-w-0 flex-col justify-between gap-6 p-6 sm:p-8 lg:col-span-5 lg:p-9 ${
              isReversed ? 'lg:order-1' : 'lg:order-2'
            }`
          : 'flex min-w-0 flex-1 flex-col justify-between gap-6 px-6 pt-3 pb-5 sm:px-8 sm:pb-6'
      }
    >
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="type-meta text-muted">
            {data.indexLabel} · {data.category}
          </span>
          <span class="whitespace-nowrap rounded-full bg-accent-soft px-3.5 py-1.5 text-xs font-semibold text-accent tabular-nums">
            {data.metric}
          </span>
        </div>

        <h3 class="type-card text-fg">{data.title}</h3>

        <p class="text-sm leading-relaxed text-fg-secondary sm:text-[0.9375rem]">
          {data.summary}
        </p>

        <p class="flex items-start gap-2.5 text-sm leading-relaxed text-fg">
          <CircleCheck
            size={16}
            stroke-width={2}
            class="mt-0.5 shrink-0 text-accent"
            aria-hidden="true"
          />
          <span>{data.outcome}</span>
        </p>
      </div>

      <div class="space-y-5">
        <ul class="flex flex-wrap gap-2" aria-label={data.title}>
          {data.stack.map((tech) => (
            <li class="tech-chip">{tech}</li>
          ))}
        </ul>

        <div class="hairline-rule" aria-hidden="true" />

        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
          {data.links.demo && (
            <a
              href={data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              title={`${labels.demoLabel} — ${data.title}`}
              class="inline-flex min-h-[44px] items-center gap-1.5 whitespace-nowrap text-sm font-semibold text-accent no-underline transition-colors hover:text-accent-hover"
            >
              <Globe size={15} stroke-width={1.9} aria-hidden="true" />
              <span>{labels.demoLabel}</span>
              <ArrowUpRight size={15} stroke-width={2} aria-hidden="true" />
            </a>
          )}

          {data.links.store && (
            <a
              href={data.links.store}
              target="_blank"
              rel="noopener noreferrer"
              title={`${labels.storeLabel} — ${data.title}`}
              class="inline-flex min-h-[44px] items-center gap-1.5 whitespace-nowrap text-sm font-medium text-fg no-underline transition-colors hover:text-accent"
            >
              <Store size={15} stroke-width={1.9} aria-hidden="true" />
              <span>{labels.storeLabel}</span>
              <ArrowUpRight size={15} stroke-width={1.9} aria-hidden="true" />
            </a>
          )}

          {data.links.repo && (
            <a
              href={data.links.repo}
              target="_blank"
              rel="noopener noreferrer"
              title={`${labels.repoLabel} — ${data.title}`}
              class="inline-flex min-h-[44px] items-center gap-1.5 whitespace-nowrap text-sm font-medium text-fg no-underline transition-colors hover:text-accent"
            >
              <CodeXml size={15} stroke-width={1.9} aria-hidden="true" />
              <span>{labels.repoLabel}</span>
              <ArrowUpRight size={15} stroke-width={1.9} aria-hidden="true" />
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>
