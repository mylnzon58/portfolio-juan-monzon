---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  aspectClass?: string;
  tone?: 'light' | 'dark';
  position?: 'top' | 'center';
  fit?: 'cover' | 'contain';
}

const {
  image,
  alt,
  sizes,
  aspectClass = 'aspect-[16/10]',
  tone = 'dark',
  position = 'center',
  fit = 'cover',
} = Astro.props;

const objectPositionClass = position === 'top' ? 'object-top' : 'object-center';
const objectFitClass = fit === 'contain' ? 'object-contain' : 'object-cover';
const stageBgClass = tone === 'light' ? 'bg-surface' : 'bg-fg';
---

<div class="overflow-hidden bg-surface-muted p-4 sm:p-6">
  <div class={`parallax-frame media-bezel relative ${stageBgClass} ${aspectClass}`}>
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[480, 768, 1200]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
      pictureAttributes={{ class: 'block h-full w-full' }}
      class={`atelier-card__media h-full w-full ${objectFitClass} ${objectPositionClass}`}
    />
  </div>
</div>
