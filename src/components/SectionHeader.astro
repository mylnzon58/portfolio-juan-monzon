---
interface Props {
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<header
  aria-label={eyebrow}
  class="grid grid-cols-1 gap-6 border-t border-border pt-10 pb-12 lg:grid-cols-12 lg:items-end lg:gap-8 lg:pt-14 lg:pb-16"
>
  <div class="min-w-0 lg:col-span-7">
    <h2 class="type-section text-fg">{title}</h2>
  </div>

  {subtitle && (
    <div class="min-w-0 lg:col-span-5">
      <p class="text-base leading-relaxed text-muted">{subtitle}</p>
    </div>
  )}
</header>
