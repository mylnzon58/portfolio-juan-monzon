---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="mb-12 lg:mb-16">
  <div class="hairline-rule mb-10 lg:mb-12" aria-hidden="true"></div>
  <header class="grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="min-w-0 lg:col-span-7">
      <h2 class="type-section text-fg">{title}</h2>
    </div>

    {subtitle && (
      <div class="min-w-0 lg:col-span-5">
        <p class="text-base leading-relaxed text-fg-secondary">{subtitle}</p>
      </div>
    )}
  </header>
</div>
