---
import {
  ArrowUp,
  ArrowUpRight,
  BriefcaseBusiness,
  CodeXml,
  Coffee,
  Globe,
  Heart,
  HeartHandshake,
  Wallet,
} from '@lucide/astro';
import SectionHeader from './SectionHeader.astro';

interface SocialLink {
  id: 'linkedin' | 'github' | 'instagram' | 'sponsors' | 'tecito' | 'patreon' | 'mercadopago';
  label: string;
  handle: string;
  href: string;
  group: 'primary' | 'support';
}

interface Cta {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  channelsTitle: string;
  supportTitle: string;
  copyright: string;
  builtWith: string;
  socialNavLabel: string;
  backToTopLabel: string;
  socials: SocialLink[];
}

const {
  eyebrow,
  title,
  subtitle,
  primaryCta,
  secondaryCta,
  channelsTitle,
  supportTitle,
  copyright,
  builtWith,
  socialNavLabel,
  backToTopLabel,
  socials,
} = Astro.props;

const primarySocials = socials.filter((item) => item.group === 'primary');
const supportSocials = socials.filter((item) => item.group === 'support');
---

<footer id="contacto" class="pt-16 pb-12 lg:pt-24 lg:pb-16">
  <div class="container-editorial">
    <SectionHeader eyebrow={eyebrow} title={title} subtitle={subtitle} />

    <div class="mb-14 flex flex-wrap items-center gap-4">
      <a
        href={primaryCta.href}
        target={primaryCta.external ? '_blank' : undefined}
        rel={primaryCta.external ? 'noopener noreferrer' : undefined}
        class="btn-primary"
      >
        <span>{primaryCta.label}</span>
        <ArrowUpRight size={16} stroke-width={2} aria-hidden="true" />
      </a>

      <a
        href={secondaryCta.href}
        target={secondaryCta.external ? '_blank' : undefined}
        rel={secondaryCta.external ? 'noopener noreferrer' : undefined}
        class="btn-secondary"
      >
        <span>{secondaryCta.label}</span>
        <ArrowUpRight size={16} stroke-width={1.75} aria-hidden="true" />
      </a>
    </div>

    <nav aria-label={socialNavLabel} class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-10">
      <div class="min-w-0 lg:col-span-6">
        <p class="type-meta mb-4 text-muted">{channelsTitle}</p>
        <ul class="divide-y divide-border border-y border-border">
          {primarySocials.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-4 py-4 text-fg no-underline transition-colors hover:text-accent"
              >
                <span class="flex min-w-0 items-center gap-3">
                  <span class="text-muted transition-colors group-hover:text-accent" aria-hidden="true">
                    {item.id === 'linkedin' && <BriefcaseBusiness size={16} stroke-width={1.75} />}
                    {item.id === 'github' && <CodeXml size={16} stroke-width={1.75} />}
                    {item.id === 'instagram' && <Globe size={16} stroke-width={1.75} />}
                  </span>
                  <span class="font-medium">{item.label}</span>
                </span>
                <span class="flex items-center gap-2 font-mono text-xs text-muted group-hover:text-accent">
                  <span class="hidden sm:inline">{item.handle}</span>
                  <ArrowUpRight size={15} stroke-width={1.75} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="min-w-0 lg:col-span-6">
        <p class="type-meta mb-4 text-muted">{supportTitle}</p>
        <ul class="divide-y divide-border border-y border-border">
          {supportSocials.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center justify-between gap-4 py-4 text-fg no-underline transition-colors hover:text-accent"
              >
                <span class="flex min-w-0 items-center gap-3">
                  <span class="text-muted transition-colors group-hover:text-accent" aria-hidden="true">
                    {item.id === 'sponsors' && <HeartHandshake size={16} stroke-width={1.75} />}
                    {item.id === 'tecito' && <Coffee size={16} stroke-width={1.75} />}
                    {item.id === 'patreon' && <Heart size={16} stroke-width={1.75} />}
                    {item.id === 'mercadopago' && <Wallet size={16} stroke-width={1.75} />}
                  </span>
                  <span class="font-medium">{item.label}</span>
                </span>
                <span class="flex items-center gap-2 font-mono text-xs text-muted group-hover:text-accent">
                  <span class="hidden sm:inline">{item.handle}</span>
                  <ArrowUpRight size={15} stroke-width={1.75} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="mt-14 flex flex-col gap-4 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-muted">
        <span>{copyright}</span>
        <span aria-hidden="true">·</span>
        <span>{builtWith}</span>
      </div>

      <a
        href="#inicio"
        class="inline-flex items-center gap-1.5 font-mono text-xs uppercase tracking-[0.08em] text-muted no-underline transition-colors hover:text-accent"
      >
        <span>{backToTopLabel}</span>
        <ArrowUp size={14} stroke-width={1.75} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

