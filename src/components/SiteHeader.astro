---
import { ArrowUpRight } from '@lucide/astro';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  monogram: string;
  brandName: string;
  nav: NavItem[];
  cta: {
    label: string;
    href: string;
    external?: boolean;
  };
  primaryNavLabel: string;
}

const { monogram, brandName, nav, cta, primaryNavLabel } = Astro.props;
---

<header class="nav-glass sticky top-0 z-40">
  <div class="container-atelier flex h-18 items-center justify-between gap-4">
    <a
      href="#inicio"
      class="inline-flex shrink-0 items-center gap-3 text-fg no-underline transition-colors hover:text-accent"
    >
      <span
        aria-hidden="true"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-fg text-xs font-semibold tracking-tight text-surface"
      >
        {monogram}
      </span>
      <span class="hidden text-sm font-semibold tracking-[-0.01em] text-fg sm:inline">
        {brandName}
      </span>
    </a>

    <nav aria-label={primaryNavLabel} class="flex min-w-0 items-center gap-4 sm:gap-7">
      <ul class="flex items-center gap-4 sm:gap-7">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-block py-2 text-xs font-medium text-muted no-underline transition-colors hover:text-fg sm:text-sm"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={cta.href}
        target={cta.external ? '_blank' : undefined}
        rel={cta.external ? 'noopener noreferrer' : undefined}
        class="hidden items-center gap-1.5 rounded-full bg-fg px-4 py-2 text-xs font-medium text-surface no-underline transition-colors hover:bg-accent md:inline-flex"
      >
        <span>{cta.label}</span>
        <ArrowUpRight size={14} stroke-width={2} aria-hidden="true" />
      </a>
    </nav>
  </div>
</header>
