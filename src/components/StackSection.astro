---
import { Compass, Cpu, Layers, Server } from '@lucide/astro';
import SectionHeader from './SectionHeader.astro';

interface StackGroup {
  id: string;
  title: string;
  icon: 'layers' | 'server' | 'cpu' | 'compass';
  summary: string;
  items: string[];
}

interface Props {
  title: string;
  subtitle: string;
  groups: StackGroup[];
}

const { title, subtitle, groups } = Astro.props;
---

<section id="stack" class="py-16 lg:py-24">
  <div class="container-atelier">
    <SectionHeader title={title} subtitle={subtitle} />

    <!-- Cuatro bloques cerámicos editoriales: título e icono en línea sin barras ni tiles genéricos -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8">
      {groups.map((group) => (
        <article class="atelier-card atelier-card--padded reveal-on-scroll flex min-w-0 flex-col justify-between gap-6">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-4">
              <h3 class="type-card text-fg">{group.title}</h3>
              <span class="shrink-0 text-accent" aria-hidden="true">
                {group.icon === 'layers' && <Layers size={20} stroke-width={1.75} />}
                {group.icon === 'server' && <Server size={20} stroke-width={1.75} />}
                {group.icon === 'cpu' && <Cpu size={20} stroke-width={1.75} />}
                {group.icon === 'compass' && <Compass size={20} stroke-width={1.75} />}
              </span>
            </div>

            <p class="text-sm leading-relaxed text-fg-secondary">{group.summary}</p>
          </div>

          <div class="space-y-5">
            <div class="hairline-rule" aria-hidden="true" />
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="tech-chip">{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
