---
import { getCollection, getEntry } from 'astro:content';
import AboutSection from '@/components/AboutSection.astro';
import HeroSection from '@/components/HeroSection.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import StackSection from '@/components/StackSection.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const profileEntry = await getEntry('site', 'profile');
if (!profileEntry) {
  throw new Error('No se encontró src/content/site/profile.json');
}

const profile = profileEntry.data;
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const knowsAbout = profile.sections.stack.groups.flatMap((group) => group.items);
---

<BaseLayout
  lang={profile.meta.lang}
  title={profile.meta.title}
  description={profile.meta.description}
  ogImage={profile.meta.ogImage}
  ogImageAlt={profile.meta.ogImageAlt}
  personName={profile.header.brandName}
  jobTitle={profile.meta.jobTitle}
  country={profile.meta.country}
  sameAs={profile.meta.sameAs}
  knowsAbout={knowsAbout}
  skipToContentLabel={profile.a11y.skipToContent}
>
  <SiteHeader
    monogram={profile.header.monogram}
    brandName={profile.header.brandName}
    nav={profile.header.nav}
    cta={profile.header.cta}
    primaryNavLabel={profile.a11y.primaryNavLabel}
  />

  <main id="contenido-principal">
    <HeroSection
      locationLine={profile.hero.locationLine}
      fullName={profile.hero.fullName}
      roleLine={profile.hero.roleLine}
      thesis={profile.hero.thesis}
      primaryCta={profile.hero.primaryCta}
      secondaryCta={profile.hero.secondaryCta}
      coverImage={profile.hero.coverImage}
      coverAlt={profile.hero.coverAlt}
      coverCaption={profile.hero.coverCaption}
      avatarImage={profile.hero.avatarImage}
      avatarAlt={profile.hero.avatarAlt}
      ledger={profile.hero.ledger}
    />

    <ProjectsSection
      title={profile.sections.projects.title}
      subtitle={profile.sections.projects.subtitle}
      labels={{
        demoLabel: profile.sections.projects.demoLabel,
        repoLabel: profile.sections.projects.repoLabel,
        storeLabel: profile.sections.projects.storeLabel,
      }}
      projects={projects}
      archiveTitle={profile.sections.projects.archiveTitle}
      archiveItems={profile.sections.projects.archiveItems}
    />

    <StackSection
      title={profile.sections.stack.title}
      subtitle={profile.sections.stack.subtitle}
      groups={profile.sections.stack.groups}
    />

    <AboutSection
      title={profile.sections.about.title}
      paragraphs={profile.sections.about.paragraphs}
      highlights={profile.sections.about.highlights}
      availabilityLabel={profile.sections.about.availabilityLabel}
      availabilityValue={profile.sections.about.availabilityValue}
    />
  </main>

  <SiteFooter
    title={profile.sections.contact.title}
    subtitle={profile.sections.contact.subtitle}
    primaryCta={profile.sections.contact.primaryCta}
    secondaryCta={profile.sections.contact.secondaryCta}
    channelsTitle={profile.sections.contact.channelsTitle}
    supportTitle={profile.sections.contact.supportTitle}
    copyright={profile.sections.contact.copyright}
    builtWith={profile.sections.contact.builtWith}
    socialNavLabel={profile.a11y.socialNavLabel}
    backToTopLabel={profile.a11y.backToTopLabel}
    socials={profile.socials}
  />
</BaseLayout>
